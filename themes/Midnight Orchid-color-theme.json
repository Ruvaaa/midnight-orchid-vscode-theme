{
  "$schema": "vscode://schemas/color-theme",
  "name": "Midnight Orchid",
  "type": "dark",
  "colors": {
    // Base Colors
    "focusBorder": "#F72585",
    "foreground": "#E6EBF8",
    "widget.shadow": "#090A0E",
    "selection.background": "#7209B766",
    "descriptionForeground": "#9096B8",
    "errorForeground": "#FF4D6D",

    // Editor
    "editor.background": "#11121A",
    "editor.foreground": "#E6EBF8",
    "editorLineNumber.foreground": "#3A3D54",
    "editorCursor.foreground": "#4CC9F0",
    "editor.selectionBackground": "#7209B740",
    "editor.selectionHighlightBackground": "#F7258525",
    "editor.wordHighlightBackground": "#4CC9F020",
    "editor.lineHighlightBackground": "#1A1B26AA",
    "editorLineNumber.activeForeground": "#4CC9F0",
    "editorIndentGuide.background1": "#1E2030",
    "editorIndentGuide.activeBackground1": "#7209B7",
    "editorWhitespace.foreground": "#2B2E42",

    // Activity Bar
    "activityBar.background": "#0E0F16",
    "activityBar.foreground": "#F72585",
    "activityBar.inactiveForeground": "#505473",
    "activityBar.border": "#1A1B26",
    "activityBarBadge.background": "#F72585",
    "activityBarBadge.foreground": "#FFFFFF",

    // Side Bar & Explorer
    "sideBar.background": "#1A1B26",
    "sideBar.foreground": "#C3C9E3",
    "sideBar.border": "#11121A",
    "sideBarTitle.foreground": "#E6EBF8",
    "sideBarSectionHeader.background": "#141520",
    "sideBarSectionHeader.foreground": "#E6EBF8",

    // Lists & Trees (File Explorer, Quick Open)
    "list.activeSelectionBackground": "#7209B750",
    "list.activeSelectionForeground": "#E6EBF8",
    "list.inactiveSelectionBackground": "#232538",
    "list.inactiveSelectionForeground": "#C3C9E3",
    "list.hoverBackground": "#222436",
    "list.focusBackground": "#7209B733",
    "list.highlightForeground": "#4CC9F0",

    // Editor Groups & Tabs
    "editorGroupHeader.tabsBackground": "#0E0F16",
    "tab.activeBackground": "#11121A",
    "tab.activeForeground": "#E6EBF8",
    "tab.border": "#141520",
    "tab.activeBorderTop": "#F72585",
    "tab.inactiveBackground": "#171824",
    "tab.inactiveForeground": "#73799D",

    // Status Bar
    "statusBar.background": "#0E0F16",
    "statusBar.foreground": "#E6EBF8",
    "statusBar.border": "#1A1B26",
    "statusBar.debuggingBackground": "#7209B7",
    "statusBar.noFolderBackground": "#0E0F16",
    "statusBarItem.remoteBackground": "#F72585",
    "statusBarItem.remoteForeground": "#FFFFFF",

    // Title Bar (Desktop Header)
    "titleBar.activeBackground": "#0E0F16",
    "titleBar.activeForeground": "#E6EBF8",
    "titleBar.inactiveBackground": "#0E0F16",
    "titleBar.inactiveForeground": "#505473",

    // Panels (Terminal, Output, Problems)
    "panel.background": "#1A1B26",
    "panel.border": "#11121A",
    "panelTitle.activeBorder": "#F72585",
    "panelTitle.activeForeground": "#E6EBF8",
    "panelTitle.inactiveForeground": "#73799D",

    // Inputs & Dropdowns
    "input.background": "#11121A",
    "input.foreground": "#E6EBF8",
    "input.border": "#2E3146",
    "input.placeholderForeground": "#606587",
    "inputOption.activeBorder": "#4CC9F0",
    "dropdown.background": "#1A1B26",
    "dropdown.border": "#2E3146",
    "dropdown.foreground": "#E6EBF8",

    // Peek View (Go to definition / references)
    "peekView.border": "#4CC9F0",
    "peekViewEditor.background": "#11121A",
    "peekViewResult.background": "#1A1B26",
    "peekViewResult.matchHighlightBackground": "#F7258540",
    "peekViewTitle.background": "#141520",

    // Integrated Terminal Colors
    "terminal.background": "#11121A",
    "terminal.foreground": "#E6EBF8",
    "terminal.ansiMagenta": "#F72585",
    "terminal.ansiBlue": "#7209B7",
    "terminal.ansiCyan": "#4CC9F0",
    "terminal.ansiBrightMagenta": "#FF5CB0",
    "terminal.ansiBrightCyan": "#70D6FF"
  },

  // --- Syntax Highlighting ---
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#52577A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#F72585",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#4CC9F0"
      }
    },
    {
      "name": "Variables",
      "scope": ["variable", "string.unquoted"],
      "settings": {
        "foreground": "#E6EBF8"
      }
    },
    {
      "name": "Strings & Character Escapes",
      "scope": ["string", "punctuation.definition.string"],
      "settings": {
        "foreground": "#C77DFF"
      }
    },
    {
      "name": "Numbers & Booleans",
      "scope": ["constant.numeric", "constant.language", "boolean"],
      "settings": {
        "foreground": "#FF75C3"
      }
    },
    {
      "name": "Classes, Types & Interfaces",
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": {
        "foreground": "#9D4EDD",
        "fontStyle": "bold"
      }
    },
    {
      "name": "HTML/JSX Tags",
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#F72585"
      }
    },
    {
      "name": "Attributes & Properties",
      "scope": ["entity.other.attribute-name", "variable.other.property"],
      "settings": {
        "foreground": "#4CC9F0"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": ["keyword.operator", "punctuation"],
      "settings": {
        "foreground": "#B8C1EC"
      }
    }
  ]
}